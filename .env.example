OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPT_FORMAT_MODEL=gpt-5.4-mini
OPENAI_TRANSFORM_MODEL=gpt-4o-mini
OPENAI_CHALLENGE_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
SATYA_VACHAN_DEMO_MODE=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TRACING_RELEASE=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Optional — Google sign-in and cloud sync. Leave blank to run guest-only on
# localStorage, exactly as the app behaved before accounts existed. Both are
# safe to expose: the anon key is the browser-facing key and every table is
# protected by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — pins the OAuth redirect to a fixed origin (e.g. your Tailscale
# host or production URL). Defaults to the origin the request came from.
NEXT_PUBLIC_APP_ORIGIN=
